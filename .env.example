# Local development configuration. Copy to .env and replace provider keys/secrets.
ENVIRONMENT=development

OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=secure-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_AUDIENCE=secure-rag-api
JWT_ISSUER=secure-rag-api
REQUIRE_AUTH=true
ALLOW_LOCAL_DEV_TOKENS=true

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_STORAGE_URI=memory://
RETRIEVAL_TOP_K=8
RERANK_TOP_K=5
MIN_RETRIEVAL_SCORE=0.20
MAX_QUERY_CHARS=2000
MAX_DOC_CHARS=2000000
MAX_UPLOAD_BYTES=25000000
MAX_CHUNK_CHARS=5000
EMBEDDING_BATCH_SIZE=64
MAX_CONTEXT_CHARS=24000
PROVIDER_MAX_ATTEMPTS=2
MAX_PDF_PAGES=200
MAX_ARCHIVE_ENTRIES=500
MAX_ARCHIVE_UNCOMPRESSED_BYTES=50000000

CORS_ALLOWED_ORIGINS=http://localhost:5173
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql+asyncpg://secure_rag:change-me-local@localhost:5432/secure_rag
PINECONE_DELETION_PROTECTION=enabled
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOG_LEVEL=INFO
